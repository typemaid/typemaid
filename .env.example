# Only needed for the live agent test and the agent example.
# Copy to .env.live (not .env: Bun loads .env automatically, which would make every test run call the model).
TYPEMAID_TEST_API_KEY=
# Optional: a proxy or gateway in front of the provider's API.
# TYPEMAID_TEST_BASE_URL=
TYPEMAID_TEST_MODEL=claude-haiku-4-5-20251001

# Optional: also run the store tests against real servers. The tests create and drop their own tables.
# Set these in your shell for one test run, for example:
#   TYPEMAID_TEST_POSTGRES_URL=postgres://user@localhost:5432/postgres bun test packages/postgres
TYPEMAID_TEST_POSTGRES_URL=
TYPEMAID_TEST_LIBSQL_URL=
TYPEMAID_TEST_LIBSQL_TOKEN=
