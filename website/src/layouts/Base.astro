---
import '../styles/global.css';
import { SITE } from '../lib/nav';
import { formatStars, REPO_URL, starCount } from '../lib/github';

interface Props {
  title: string;
  description: string;
  /** Adds JSON-LD that describes the product. Home page only. */
  jsonLd?: Record<string, unknown>;
  /** The page's plain Markdown copy, for AI agents. Docs pages only. */
  markdown?: string;
  /** Connect early to the CDN that serves Mermaid. For pages that draw a diagram as soon as they load. */
  preconnectCdn?: boolean;
}

const { title, description, jsonLd, markdown, preconnectCdn } = Astro.props;
const stars = await starCount();
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, SITE).toString();
const ogImage = new URL('/og.png', SITE).toString();
const isDocs = pathname.startsWith('/docs/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    {preconnectCdn && <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Docs index for AI agents (llms.txt)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TypeMaid" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TypeMaid: transform your Mermaid diagrams into AI workflows. A TypeScript SDK." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="TypeMaid: transform your Mermaid diagrams into AI workflows. A TypeScript SDK." />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <button class="menu-button" type="button" aria-label="Open the docs menu" aria-controls="sidebar" aria-expanded="false" data-menu>
          <span></span><span></span><span></span>
        </button>
        <a class="wordmark" href="/" aria-label="TypeMaid home">
          <svg class="mark" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true"><rect width="64" height="64" rx="6" fill="#3178c6"/><text x="58" y="56" text-anchor="end" font-family="Segoe UI, -apple-system, Helvetica, Arial, sans-serif" font-size="30" font-weight="700" letter-spacing="-1" fill="#fff">TM</text></svg>
          <span class="word">Type<span>Maid</span></span>
        </a>
        <nav class="topnav" aria-label="Main">
          <a href="/docs/" aria-current={isDocs && !pathname.startsWith('/docs/examples/') && !pathname.startsWith('/docs/api/') ? 'true' : undefined}>Docs</a>
          <a href="/docs/examples/hello/" aria-current={pathname.startsWith('/docs/examples/') ? 'true' : undefined}>Examples</a>
          <a href="/docs/api/run/" aria-current={pathname.startsWith('/docs/api/') ? 'true' : undefined}>API</a>
        </nav>
        <div class="topbar-tools">
          <div id="search" class="search" data-search>
            <label class="search-stub">
              <svg viewBox="0 0 18 18" width="13" height="13" aria-hidden="true"><path d="M12.75 11.25h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99 1.49-1.49-4.99-5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z" fill="currentColor"/></svg>
              <input type="search" placeholder="Search docs" aria-label="Search docs" autocomplete="off" data-search-stub />
            </label>
          </div>
          <a class="github" href={REPO_URL} aria-label={stars === undefined ? 'TypeMaid on GitHub' : `Star TypeMaid on GitHub (${stars} stars)`}>
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="github-star">
              <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .67.42l1.88 3.8 4.2.61a.75.75 0 0 1 .41 1.28l-3.04 2.96.72 4.18a.75.75 0 0 1-1.09.79L8 12.32l-3.75 1.97a.75.75 0 0 1-1.09-.79l.72-4.18L.84 6.36a.75.75 0 0 1 .41-1.28l4.2-.61L7.33.67A.75.75 0 0 1 8 .25z"/></svg>
              {stars ? formatStars(stars) : 'Star'}
            </span>
          </a>
        </div>
      </div>
    </header>

    <slot />

    <script is:inline>
      (function () {
        // The top bar shows its bottom border only once the page is scrolled.
        var topbar = document.querySelector('.topbar');
        function onScroll() { topbar.classList.toggle('is-scrolled', window.scrollY > 4); }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // Mobile menu.
        var menu = document.querySelector('[data-menu]');
        var sidebar = document.getElementById('sidebar');
        if (menu && sidebar) {
          menu.addEventListener('click', function () {
            var open = document.body.classList.toggle('menu-open');
            menu.setAttribute('aria-expanded', String(open));
          });
        } else if (menu) {
          menu.hidden = true;
        }

        // Copy buttons on code blocks.
        document.querySelectorAll('pre.astro-code').forEach(function (pre) {
          var copy = document.createElement('button');
          copy.type = 'button';
          copy.className = 'copy';
          copy.textContent = 'Copy';
          copy.setAttribute('aria-label', 'Copy code');
          copy.addEventListener('click', function () {
            navigator.clipboard.writeText(pre.querySelector('code').innerText).then(function () {
              copy.textContent = 'Copied';
              setTimeout(function () { copy.textContent = 'Copy'; }, 1500);
            });
          });
          var wrap = document.createElement('div');
          wrap.className = 'code-wrap';
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(pre);
          wrap.appendChild(copy);
        });

        // "Copy page": copies the page's Markdown copy. The text is fetched on click; ClipboardItem
        // takes a promise, so Safari still treats the copy as part of the click.
        var copyButtons = document.querySelectorAll('[data-copy-page]');
        copyButtons.forEach(function (b) {
          b.addEventListener('click', function () {
            var url = b.getAttribute('data-copy-page');
            var text = fetch(url).then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.text();
            });
            var done = window.ClipboardItem && navigator.clipboard.write
              ? navigator.clipboard.write([new ClipboardItem({ 'text/plain': text.then(function (t) { return new Blob([t], { type: 'text/plain' }); }) })])
              : text.then(function (t) { return navigator.clipboard.writeText(t); });
            var label = document.querySelector('[data-copy-label]');
            done.then(function () {
              if (label) { label.textContent = 'Copied'; setTimeout(function () { label.textContent = 'Copy page'; }, 1500); }
            }, function () {
              if (label) label.textContent = 'Copy failed';
            });
            var menu = b.closest('details');
            if (menu) menu.open = false;
          });
        });
        // Close the page menu on a click elsewhere or Escape.
        document.addEventListener('click', function (e) {
          document.querySelectorAll('details.page-menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.open = false; });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') document.querySelectorAll('details.page-menu[open]').forEach(function (d) { d.open = false; });
        });

        // Search, from the Pagefind index built after the site (missing in `astro dev`). Its script and styles
        // load only when someone reaches for the search box; until then a plain input stands in for it.
        var mount = document.querySelector('[data-search]');
        var stub = mount.querySelector('[data-search-stub]');
        var loading = false;
        function loadSearch() {
          if (loading) return;
          loading = true;
          var css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = '/pagefind/pagefind-ui.css';
          var cssReady = new Promise(function (resolve) { css.onload = css.onerror = resolve; });
          document.head.appendChild(css);
          var s = document.createElement('script');
          s.src = '/pagefind/pagefind-ui.js';
          s.onload = function () {
            cssReady.then(function () {
              var typed = stub.value;
              var focused = document.activeElement === stub;
              mount.replaceChildren();
              var ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false, translations: { placeholder: 'Search docs' } });
              var input = mount.querySelector('input');
              if (focused && input) input.focus();
              if (typed) ui.triggerSearch(typed);
            });
          };
          s.onerror = function () { mount.hidden = true; };
          document.head.appendChild(s);
        }
        stub.addEventListener('focus', loadSearch);
        mount.addEventListener('pointerenter', loadSearch, { once: true });
      })();
    </script>
  </body>
</html>
