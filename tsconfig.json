{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "typemaid": [
        "./src/index.ts"
      ],
      "typemaid/sqlite": [
        "./src/sqlite/index.ts"
      ],
      "typemaid/ai": [
        "./src/ai/index.ts"
      ],
      "typemaid/node": [
        "./src/node/index.ts"
      ],
      "@typemaid/view": [
        "./packages/view/src/index.ts"
      ],
      "@typemaid/postgres": [
        "./packages/postgres/src/index.ts"
      ],
      "@typemaid/libsql": [
        "./packages/libsql/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "*.ts"
  ]
}
