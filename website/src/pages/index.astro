---
import fs from 'node:fs';
import path from 'node:path';
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/nav';
import { REPO_URL } from '../lib/github';

// The landing page shows the real support-triage example, the same files the test suite runs.
// Builds run from website/, so the repository root is one level up.
const repoRoot = path.resolve(process.cwd(), '..');
const read = (rel: string) => fs.readFileSync(path.join(repoRoot, rel), 'utf8').trimEnd();
const diagram = read('examples/triage/triage.mmd');
// The live diagram is the same file, drawn left to right so it fits the stage.
const stageDiagram = diagram.replace(/^flowchart\s+TD/m, 'flowchart LR');
// The first steps of the tools file, cut cleanly before `reply`.
const toolLines = read('examples/triage/tools.ts').split('\n');
const cut = toolLines.findIndex((line) => line.startsWith('export const reply'));
const tools = `${toolLines.slice(0, cut).join('\n').trimEnd()}\n\n// … reply, send and closeTicket`;

const runCode = `import { run, resume } from 'typemaid';
import { sqliteStore } from 'typemaid/sqlite';
import * as tools from './tools.ts';

const store = sqliteStore('./runs.db');
const result = await run('./triage.mmd', tools, { ticketId: 'T-URGENT' }, { store });
// { status: 'paused', waitingAt: [{ node: 'approve', options: ['approved', 'rejected'] }] }

await resume(result.runId, tools, { decision: 'approved', note: 'on it' }, { store });
// { status: 'completed', output: { priority: 5, sent: true, ... } }`;

// pnpm does not let your code import a peer dependency it installed for typemaid, so Zod is added there.
const installCommands = [
  { pm: 'npm', command: 'npm i typemaid' },
  { pm: 'pnpm', command: 'pnpm add typemaid zod' },
  { pm: 'bun', command: 'bun add typemaid' },
];

const description = 'TypeMaid turns Mermaid diagrams into AI workflows: each box is a typed TypeScript step, and runs pause for people, retry and resume after a restart.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'TypeMaid', url: `${SITE}/` },
    {
      '@type': 'SoftwareApplication',
      name: 'TypeMaid',
      alternateName: 'typemaid',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Node.js, Bun',
      description,
      url: `${SITE}/`,
      downloadUrl: 'https://www.npmjs.com/package/typemaid',
      sameAs: [REPO_URL, 'https://www.npmjs.com/package/typemaid'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};

const steps = [
  { n: '01', title: 'Draw', body: 'The flow is a Mermaid flowchart. GitHub, Notion and your editor already draw it.', file: 'triage.mmd', code: diagram, lang: 'mermaid' },
  { n: '02', title: 'Type', body: 'Each box is an export: a small function with a Zod input and output.', file: 'tools.ts', code: tools, lang: 'ts' },
  { n: '03', title: 'Run', body: 'One call runs it. Pause for a person, save the run, resume it tomorrow.', file: 'index.ts', code: runCode, lang: 'ts' },
];

const features = [
  { icon: 'M4 6h6v5H4zM14 13h6v5h-6zM7 11v4h7', title: 'The diagram is the program', body: 'Branches, loops, parallel steps and for-each blocks are drawn in Mermaid. No model decides which step runs next.' },
  { icon: 'M5 12l4 4L19 6', title: 'Typed end to end', body: 'Every step declares its input and output with Zod. Mistakes are reported before anything runs, with the file, line and a fix.' },
  { icon: 'M12 3a4 4 0 1 1 0 8a4 4 0 0 1 0-8zM4 21c0-4 4-6 8-6s8 2 8 6', title: 'People in the loop', body: 'A human step pauses the run. Save it, and resume it hours later with the answer, even from another process.' },
  { icon: 'M12 2l2.5 6.5L21 9l-5 4.5L17.5 21 12 17l-5.5 4L8 13.5 3 9l6.5-.5z', title: 'Any AI model', body: 'Agent steps and model calls go through the Vercel AI SDK: OpenAI, Anthropic, Gemini, Ollama, LiteLLM and every other provider it supports.' },
  { icon: 'M4 7c0-2 16-2 16 0v10c0 2-16 2-16 0zM4 7c0 2 16 2 16 0M4 12c0 2 16 2 16 0', title: 'Survives restarts', body: 'Runs are saved to SQLite, Postgres or libSQL. A run that crashed picks up from the last finished step.' },
  { icon: 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 1 0 6a3 3 0 0 1 0-6z', title: 'See every flow', body: 'typemaid view draws every workflow, lists each step with its fields and shows problems as you save.' },
];

const providers = ['OpenAI', 'Anthropic', 'Google Gemini', 'Vertex AI', 'Azure OpenAI', 'Amazon Bedrock', 'Mistral', 'xAI Grok', 'Groq', 'DeepSeek', 'Cohere', 'Together AI', 'Fireworks', 'Cerebras', 'Perplexity', 'OpenRouter', 'Ollama', 'LiteLLM'];

const modelCode = `import { openai } from '@ai-sdk/openai';
import { defineAI } from 'typemaid/ai';

export const ai = defineAI({ model: openai('gpt-5-mini') });

// Switch provider by changing one line:
// defineAI({ model: anthropic('claude-haiku-4-5') })
// defineAI({ model: ollama('llama3.2') })
// defineAI({ model: litellm('gpt-4o-mini') })`;

const packages = [
  { name: 'typemaid', body: 'run, resume, check, plus typemaid/ai and typemaid/sqlite' },
  { name: '@typemaid/postgres', body: 'keep runs in Postgres' },
  { name: '@typemaid/libsql', body: 'keep runs in libSQL or Turso' },
  { name: '@typemaid/view', body: 'the local workflow viewer' },
];
---
<Base title="TypeMaid: Transform your Mermaid diagrams into AI workflows" description={description} jsonLd={jsonLd} preconnectCdn>
  <main id="content" class="home">
    <section class="stage">
      <div class="hero">
        <div class="hero-head">
          <h1>Transform your Mermaid diagrams into AI workflows.</h1>
        </div>
        <div class="hero-body">
          <p class="lede">A TypeScript SDK that turns your Mermaid diagrams into AI workflows. Works with any LLM: OpenAI, Anthropic, Gemini, Ollama, LiteLLM and every AI SDK provider.</p>
          <div class="cta">
            <a class="button primary" href="/docs/getting-started/">Get started</a>
            <a class="button ghost" href="/docs/examples/support-triage/">Read the example</a>
          </div>
          <div class="install" data-install>
            <div class="install-tabs" role="group" aria-label="Package manager">
              {installCommands.map((c, i) => (
                <button type="button" data-pm={c.pm} data-command={c.command} aria-pressed={i === 0 ? 'true' : 'false'}>{c.pm}</button>
              ))}
            </div>
            <div class="install-line">
              <span class="prompt">$</span><code data-install-command>{installCommands[0]!.command}</code>
              <button type="button" data-copy-install aria-label="Copy the install command">Copy</button>
            </div>
          </div>
        </div>
      </div>

      <figure class="flow-window" data-hero-flow data-source={stageDiagram} data-source-narrow={diagram}>
        <div class="window-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="window-title">examples/triage/triage.mmd</span>
          <span class="status" data-status data-kind="running">starting</span>
        </div>
        <div class="window-body">
          <div class="canvas" data-canvas role="img" aria-label="The support-triage workflow: fetch ticket, classify, and if priority is 4 or more wait for a manager's approval; then draft and send a reply, or close the ticket.">
            <div class="canvas-skeleton" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <aside class="run-log">
            <p class="run-head">run <strong data-ticket>…</strong></p>
            <ol data-log aria-live="off"></ol>
          </aside>
        </div>
        <figcaption>The diagram above is the real file from the examples, drawn by Mermaid. typemaid runs it exactly as drawn.</figcaption>
      </figure>
    </section>

    <section class="how">
      <p class="section-kicker">How it works</p>
      <h2>Three files. That's the whole workflow.</h2>
      <div class="how-grid">
        {steps.map((s) => (
          <article class="how-step">
            <header>
              <span class="how-n">{s.n}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </header>
            <div class="pane">
              <div class="code-title">{s.file}</div>
              <Code code={s.code} lang={s.lang as 'ts'} theme="github-dark" />
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="models">
      <div>
        <p class="section-kicker">Any LLM</p>
        <h2>Works with every model the AI SDK supports.</h2>
        <p class="models-lede">Agent steps and model calls go through the <a href="https://ai-sdk.dev">Vercel AI SDK</a>. Use any of its providers, a local model through Ollama, or LiteLLM and any OpenAI-compatible server. New models work as soon as their provider does.</p>
        <ul class="provider-list" aria-label="Supported providers">
          {providers.map((p) => <li>{p}</li>)}
        </ul>
        <a class="models-link" href="/docs/models/#providers">See every provider and how to connect it →</a>
      </div>
      <div class="pane">
        <div class="code-title">ai.ts</div>
        <Code code={modelCode} lang="ts" theme="github-dark" />
      </div>
    </section>

    <section class="features-wrap">
      <p class="section-kicker">Why typemaid</p>
      <h2>What you see is what runs.</h2>
      <div class="features">
        {features.map((f) => (
          <div class="feature">
            <span class="feature-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20"><path d={f.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="packages">
      <div>
        <p class="section-kicker">Small by default</p>
        <h2>Four packages. Use only what you need.</h2>
        <p class="packages-lede">The core has no dependencies besides Zod and runs on Node, Bun, browsers and edge workers. Storage and the viewer are separate.</p>
      </div>
      <ul class="package-list">
        {packages.map((p) => (
          <li><code>{p.name}</code><span>{p.body}</span></li>
        ))}
      </ul>
    </section>

    <section class="final">
      <h2>Draw the workflow. Type the steps. <span class="shine">Run it.</span></h2>
      <div class="cta">
        <a class="button primary" href="/docs/getting-started/">Start the quickstart</a>
        <a class="button ghost" href="/docs/">Read the docs</a>
      </div>
      <div class="next-links">
        <a href="/docs/concepts/diagrams/">Core concepts</a>
        <a href="/docs/examples/hello/">Examples</a>
        <a href="/docs/api/run/">API reference</a>
        <a href="/llms.txt">llms.txt</a>
      </div>
    </section>
  </main>
  <footer class="footer">
    <p>typemaid · <a href="/docs/">Docs</a> · <a href="/docs/faq/">FAQ</a> · <a href="/docs/contributing/">Contributing</a> · Licensed under FSL-1.1-MIT</p>
  </footer>
</Base>

<script>
  import '../scripts/hero-flow';

  const command = document.querySelector<HTMLElement>('[data-install-command]');
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-pm]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      if (command) command.textContent = tab.dataset.command ?? '';
    }),
  );

  const button = document.querySelector<HTMLButtonElement>('[data-copy-install]');
  button?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(command?.textContent ?? '');
    button.textContent = 'Copied';
    setTimeout(() => (button.textContent = 'Copy'), 1500);
  });
</script>
