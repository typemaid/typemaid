# Plain Markdown copies of the docs pages, for AI agents and the "Copy page" button.
# Search engines should index the HTML pages, so the copies are not indexed.
/docs/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

# Built assets have a content hash in their name, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The search index changes with every deploy.
/pagefind/*
  Cache-Control: public, max-age=3600
