---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import { SITE, sections, routeOf, markdownRouteOf, sectionOf, neighbours, type DocPage } from '../lib/nav';

interface Props {
  page: DocPage;
  headings: MarkdownHeading[];
  /** Add an h1 when the Markdown source does not start with one. */
  addTitle?: boolean;
}

const { page, headings, addTitle = false } = Astro.props;
const current = routeOf(page);
const section = sectionOf(page);
const { prev, next } = neighbours(page);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const markdown = markdownRouteOf(page);
// "Open in ..." starts a chat that reads this page's Markdown copy.
const prompt = encodeURIComponent(`Read ${SITE}${markdown} (a page of the typemaid docs) so I can ask questions about it.`);
const openIn = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?hints=search&q=${prompt}` },
  { name: 'Claude', href: `https://claude.ai/new?q=${prompt}` },
];
const title = page.slug === '' ? 'TypeMaid docs: Mermaid workflows with typed steps' : `${page.title} · TypeMaid docs`;
---
<Base title={title} description={page.description} markdown={markdown}>
  <div class="docs">
    <aside class="sidebar" id="sidebar">
      <nav aria-label="Documentation">
        {sections.map((s) => (
          <div class="side-group">
            <p class="side-title">{s.title}</p>
            <ul>
              {s.pages.map((p) => (
                <li>
                  <a href={routeOf(p)} aria-current={routeOf(p) === current ? 'page' : undefined}>{p.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main id="content" class="doc-main">
      <article class="prose" data-pagefind-body>
        <div class="page-head">
          <p class="eyebrow">{section.title}</p>
          <div class="page-actions" data-pagefind-ignore>
            <button class="page-copy" type="button" data-copy-page={markdown}>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              <span data-copy-label>Copy page</span>
            </button>
            <details class="page-menu">
              <summary aria-label="More ways to use this page">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <ul>
                <li>
                  <button type="button" data-copy-page={markdown}><strong>Copy page</strong><span>Copy this page as Markdown</span></button>
                </li>
                <li>
                  <a href={markdown} data-markdown-link><strong>View as Markdown</strong><span>Plain text for people and AI agents</span></a>
                </li>
                {openIn.map((o) => (
                  <li>
                    <a href={o.href} target="_blank" rel="noopener"><strong>Open in {o.name}</strong><span>Ask questions about this page</span></a>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        </div>
        {addTitle && <h1>{page.title}</h1>}
        <slot />
      </article>

      <nav class="pager" aria-label="Previous and next pages">
        {prev ? (
          <a class="pager-link prev" href={routeOf(prev)} rel="prev">
            <span>Previous</span>
            <strong>{prev.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a class="pager-link next" href={routeOf(next)} rel="next">
            <span>Next</span>
            <strong>{next.title}</strong>
          </a>
        ) : <span />}
      </nav>
    </main>

    <aside class="toc" aria-label="On this page">
      {toc.length > 0 && (
        <>
          <p class="toc-title">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </>
      )}
    </aside>
  </div>
</Base>

<script>
  import '../scripts/mermaid-preview';
</script>
