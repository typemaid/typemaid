{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run build)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun test:*)",
      "Bash(bun run lint:pkg)",
      "Bash(bun run check:examples)",
      "Bash(bun run smoke)",
      "Bash(bun run runtimes)",
      "Bash(bun dist/cli.mjs check:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.live)",
      "Read(./.env.local)",
      "Bash(npm publish:*)",
      "Bash(bun publish:*)"
    ]
  }
}
