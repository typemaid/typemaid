---
import '../styles/global.css';
import { SITE } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  /** Adds JSON-LD that describes the product. Home page only. */
  jsonLd?: Record<string, unknown>;
  /** The page's plain Markdown copy, for AI agents. Docs pages only. */
  markdown?: string;
}

const { title, description, jsonLd, markdown } = Astro.props;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, SITE).toString();
const ogImage = new URL('/og.png', SITE).toString();
const isDocs = pathname.startsWith('/docs/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Docs index for AI agents (llms.txt)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="typemaid docs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="typemaid: AI workflows made simple. A TypeScript SDK." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <button class="menu-button" type="button" aria-label="Open the docs menu" aria-controls="sidebar" aria-expanded="false" data-menu>
          <span></span><span></span><span></span>
        </button>
        <a class="wordmark" href="/" aria-label="typemaid home">
          <svg class="mark" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true"><rect width="64" height="64" rx="6" fill="#3178c6"/><text x="58" y="56" text-anchor="end" font-family="Segoe UI, -apple-system, Helvetica, Arial, sans-serif" font-size="30" font-weight="700" letter-spacing="-1" fill="#fff">TM</text></svg>
          <span class="word">type<span>maid</span></span>
        </a>
        <nav class="topnav" aria-label="Main">
          <a href="/docs/" aria-current={isDocs && !pathname.startsWith('/docs/examples/') && !pathname.startsWith('/docs/api/') ? 'true' : undefined}>Docs</a>
          <a href="/docs/examples/hello/" aria-current={pathname.startsWith('/docs/examples/') ? 'true' : undefined}>Examples</a>
          <a href="/docs/api/run/" aria-current={pathname.startsWith('/docs/api/') ? 'true' : undefined}>API</a>
        </nav>
        <div class="topbar-tools">
          <div id="search" class="search" data-search></div>
        </div>
      </div>
    </header>

    <slot />

    <script is:inline>
      (function () {
        // The top bar shows its bottom border only once the page is scrolled.
        var topbar = document.querySelector('.topbar');
        function onScroll() { topbar.classList.toggle('is-scrolled', window.scrollY > 4); }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // Mobile menu.
        var menu = document.querySelector('[data-menu]');
        var sidebar = document.getElementById('sidebar');
        if (menu && sidebar) {
          menu.addEventListener('click', function () {
            var open = document.body.classList.toggle('menu-open');
            menu.setAttribute('aria-expanded', String(open));
          });
        } else if (menu) {
          menu.hidden = true;
        }

        // Copy buttons on code blocks.
        document.querySelectorAll('pre.astro-code').forEach(function (pre) {
          var copy = document.createElement('button');
          copy.type = 'button';
          copy.className = 'copy';
          copy.textContent = 'Copy';
          copy.setAttribute('aria-label', 'Copy code');
          copy.addEventListener('click', function () {
            navigator.clipboard.writeText(pre.querySelector('code').innerText).then(function () {
              copy.textContent = 'Copied';
              setTimeout(function () { copy.textContent = 'Copy'; }, 1500);
            });
          });
          var wrap = document.createElement('div');
          wrap.className = 'code-wrap';
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(pre);
          wrap.appendChild(copy);
        });

        // "Copy page": copies the page's Markdown copy. The text is fetched on click; ClipboardItem
        // takes a promise, so Safari still treats the copy as part of the click.
        var copyButtons = document.querySelectorAll('[data-copy-page]');
        copyButtons.forEach(function (b) {
          b.addEventListener('click', function () {
            var url = b.getAttribute('data-copy-page');
            var text = fetch(url).then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.text();
            });
            var done = window.ClipboardItem && navigator.clipboard.write
              ? navigator.clipboard.write([new ClipboardItem({ 'text/plain': text.then(function (t) { return new Blob([t], { type: 'text/plain' }); }) })])
              : text.then(function (t) { return navigator.clipboard.writeText(t); });
            var label = document.querySelector('[data-copy-label]');
            done.then(function () {
              if (label) { label.textContent = 'Copied'; setTimeout(function () { label.textContent = 'Copy page'; }, 1500); }
            }, function () {
              if (label) label.textContent = 'Copy failed';
            });
            var menu = b.closest('details');
            if (menu) menu.open = false;
          });
        });
        // Close the page menu on a click elsewhere or Escape.
        document.addEventListener('click', function (e) {
          document.querySelectorAll('details.page-menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.open = false; });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') document.querySelectorAll('details.page-menu[open]').forEach(function (d) { d.open = false; });
        });

        // Search, from the Pagefind index built after the site (missing in `astro dev`).
        var mount = document.querySelector('[data-search]');
        var s = document.createElement('script');
        s.src = '/pagefind/pagefind-ui.js';
        s.onload = function () {
          new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false, translations: { placeholder: 'Search docs' } });
        };
        s.onerror = function () { mount.hidden = true; };
        document.head.appendChild(s);
      })();
    </script>
  </body>
</html>
