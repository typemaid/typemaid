{
  "name": "@typemaid/view",
  "version": "0.27.1",
  "description": "A local page that draws your typemaid workflows and shows what each step reads and writes.",
  "license": "FSL-1.1-MIT",
  "homepage": "https://typemaid.pages.dev",
  "author": "HITESH CHAWLA",
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun run build:ui",
    "build:ui": "bun scripts/build-ui.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "typemaid": "0.27.1"
  },
  "devDependencies": {
    "typemaid": "workspace:*",
    "mermaid": "12.3.0",
    "preact": "^11.2.0"
  },
  "keywords": [
    "workflow",
    "mermaid",
    "flowchart",
    "viewer",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  }
}
